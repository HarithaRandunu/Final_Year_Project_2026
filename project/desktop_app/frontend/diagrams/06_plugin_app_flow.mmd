flowchart TD
    start(["User wants to monitor/scale a different app"])
    preset["Path A: pick a built-in preset\n(e.g. TeaStore)"]
    existing["Path B: point at a Deployment\nalready running in the cluster\n(kubectl get deployments -> pick one)"]
    manifest["Path C: supply a Kubernetes manifest\n(kubectl apply -f <file/folder>)"]
    picker["Pick which resulting Deployment\nis the 'front door' to monitor"]
    identity["Resolve TARGET_DEPLOYMENT,\nTARGET_LABEL_SELECTOR, PROBE_URL, NAMESPACE"]
    reconfig["kubectl set env on\nmodule1-controller + actuator"]
    restart["kubectl rollout restart\nmodule1-controller + actuator"]
    forwards["Stop port-forwards -> wait for rollout ready\n-> restart port-forwards"]
    done(["Live monitoring now reflects the new target app"])

    start --> preset --> identity
    start --> existing --> identity
    start --> manifest --> picker --> identity
    identity --> reconfig --> restart --> forwards --> done
